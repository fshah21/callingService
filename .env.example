# HTTP server
PORT=3000

# Redis (live call state + BullMQ job queue)
REDIS_URL=redis://redis:6379

# Postgres (durable/periodic persistence)
DATABASE_URL=postgres://callservice:callservice@postgres:5432/callservice

# How often the persistence worker flushes live Redis call state to Postgres
PERSIST_INTERVAL_MS=10000

# Call simulation timing (milliseconds), min-max ranges
CALL_QUEUED_TO_RINGING_MS_MIN=500
CALL_QUEUED_TO_RINGING_MS_MAX=2000
CALL_RINGING_MS_MIN=2000
CALL_RINGING_MS_MAX=6000
CALL_ANSWERED_DURATION_MS_MIN=5000
CALL_ANSWERED_DURATION_MS_MAX=30000
CALL_UNANSWERED_TO_COMPLETED_MS_MIN=500
CALL_UNANSWERED_TO_COMPLETED_MS_MAX=1500

# Probability (0-1) that a ringing call is answered vs unanswered
CALL_ANSWER_PROBABILITY=0.7

# S3-compatible object store for mock call recordings (MinIO in docker-compose)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=call-recordings
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

LOG_LEVEL=info
